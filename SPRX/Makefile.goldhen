# GoldHEN Plugins-compatible PRX build for PS4 BO3 Customs.
# Requires OO_PS4_TOOLCHAIN and GOLDHEN_SDK (GoldHEN_Plugins_SDK checkout).
ifndef OO_PS4_TOOLCHAIN
$(error OO_PS4_TOOLCHAIN is not set; point it at the extracted OpenOrbis PS4 toolchain root)
endif
ifndef GOLDHEN_SDK
$(error GOLDHEN_SDK is not set; point it at GoldHEN_Plugins_SDK)
endif

CLANG   ?= clang-18
CLANGXX ?= clang++-18
LLD     ?= ld.lld-18
NM      ?= nm
READELF ?= readelf
TOOLCHAIN := $(OO_PS4_TOOLCHAIN)
BUILD_DIR := build/goldhen
TARGET := $(BUILD_DIR)/BO3-Customs.prx
ELF := $(BUILD_DIR)/BO3-Customs.elf
OELF := $(BUILD_DIR)/BO3-Customs.oelf
CRT := $(BUILD_DIR)/crtprx.o
LINKER_SCRIPT := $(BUILD_DIR)/link.x
SYMBOL_REPORT := $(BUILD_DIR)/BO3-Customs.symbols.txt

LIBS := -lc++ -lSceLibcInternal -lkernel -lSceSysmodule -lSceUserService
COMMON_FLAGS := --target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables \
	-DBO3_OPENORBIS=1 -DBO3_GOLDHEN_PLUGIN=1 -Iopenorbis_compat \
	-isysroot $(TOOLCHAIN) -isystem $(TOOLCHAIN)/include
CFLAGS := $(COMMON_FLAGS) -c
CXXFLAGS := $(COMMON_FLAGS) -isystem $(TOOLCHAIN)/include/c++/v1 -std=c++20 -fno-exceptions -c
LDFLAGS := -m elf_x86_64 -pie --export-dynamic --script $(LINKER_SCRIPT) -e _init --eh-frame-hdr \
	-L$(TOOLCHAIN)/lib $(LIBS)

C_SOURCES := HDE64.c
CPP_SOURCES := $(filter-out libjbc.cpp,$(wildcard *.cpp))
OBJECTS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(C_SOURCES)) \
	$(patsubst %.cpp,$(BUILD_DIR)/%.o,$(CPP_SOURCES))

.PHONY: all clean check-tools
all: check-tools $(TARGET)

check-tools:
	@test -f "$(TOOLCHAIN)/link.x" || (echo "ERROR: $(TOOLCHAIN)/link.x not found" >&2; exit 1)
	@test -f "$(TOOLCHAIN)/lib/crtlib.o" || (echo "ERROR: OpenOrbis crtlib.o missing" >&2; exit 1)
	@test -f "$(GOLDHEN_SDK)/crt/crtprx.c" || (echo "ERROR: GoldHEN SDK crt/crtprx.c missing" >&2; exit 1)
	@command -v "$(CLANGXX)" >/dev/null 2>&1 || (echo "ERROR: $(CLANGXX) not found" >&2; exit 1)
	@command -v "$(LLD)" >/dev/null 2>&1 || (echo "ERROR: $(LLD) not found" >&2; exit 1)
	@command -v "$(NM)" >/dev/null 2>&1 || (echo "ERROR: $(NM) not found" >&2; exit 1)
	@command -v "$(READELF)" >/dev/null 2>&1 || (echo "ERROR: $(READELF) not found" >&2; exit 1)
	@test -x "$(TOOLCHAIN)/bin/linux/create-fself" || (echo "ERROR: OpenOrbis create-fself missing" >&2; exit 1)

$(BUILD_DIR):
	mkdir -p "$@"

$(LINKER_SCRIPT): $(TOOLCHAIN)/link.x prepare_openorbis_linker.py | $(BUILD_DIR)
	python3 prepare_openorbis_linker.py "$<" "$@"

# Follow the GoldHEN_Plugins_SDK CRT build pattern using its pinned public CRT.
$(CRT): $(GOLDHEN_SDK)/crt/crtprx.c | $(BUILD_DIR)
	$(CLANG) --target=x86_64-pc-linux-gnu -ffreestanding -nostdlib -fno-builtin -fPIC \
		-isysroot "$(TOOLCHAIN)" -isystem "$(TOOLCHAIN)/include" -c "$<" -o "$@"

$(BUILD_DIR)/%.o: %.cpp | $(BUILD_DIR)
	$(CLANGXX) $(CXXFLAGS) -o "$@" "$<"

$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	$(CLANG) $(CFLAGS) -o "$@" "$<"

$(ELF): $(OBJECTS) $(CRT) $(LINKER_SCRIPT)
	$(LLD) "$(CRT)" $(OBJECTS) -o "$@" $(LDFLAGS)
	@python3 verify_goldhen_elf.py --nm "$(NM)" --readelf "$(READELF)" "$@" > "$(SYMBOL_REPORT)" 2>&1 || { cat "$(SYMBOL_REPORT)"; exit 1; }
	@cat "$(SYMBOL_REPORT)"

$(TARGET): $(ELF)
	"$(TOOLCHAIN)/bin/linux/create-fself" -in="$(ELF)" -out="$(OELF)" --lib="$(TARGET)" --paid=0x3800000000000011 --fwversion=0x04050000
	@test -s "$@" || (echo "ERROR: create-fself did not produce $(TARGET)" >&2; exit 1)
	@file "$@"
	@sha256sum "$@" | tee "$(TARGET).sha256"

clean:
	rm -f "$(BUILD_DIR)"/*.o "$(ELF)" "$(OELF)" "$(TARGET)" "$(TARGET).sha256" "$(LINKER_SCRIPT)" "$(SYMBOL_REPORT)"
